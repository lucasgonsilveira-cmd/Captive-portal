# ============================================================================
# CONFIG.ENV — único lugar para ajustar o portal (lido pelos scripts e pelo app.py)
# Regras: uma variável por linha, SEM aspas, SEM espaços ao redor do "=",
# comentários só em linhas próprias (começando com #).
# ============================================================================

# Interface Wi-Fi que vira o hotspot (descubra com: ip -br link)
# Se mudar aqui, mude também "interface=" no hostapd.conf e no dnsmasq.conf
AP_IF=wlan0

# Interface por onde a internet chega: cabo (eth0), USB do celular (usb0 / enx...)
# ou um 2º adaptador Wi-Fi USB (wlan1). Pode ficar sem internet: o portal funciona igual.
UP_IF=eth0

# IP do TV box dentro da rede do hotspot (mesmo valor do dnsmasq.conf)
PORTAL_IP=192.168.50.1

# Quanto tempo o visitante fica liberado depois de clicar no botão
SESSAO_MINUTOS=120

# Banco de dados (crie o usuário conforme o README)
DB_HOST=127.0.0.1
DB_USER=portal
DB_PASS=TROQUE-ESTA-SENHA
DB_NAME=portal_fatec

# Segredo usado para "embaralhar" o MAC antes de gravar no banco
# (o banco nunca guarda o MAC real). Gere um com: openssl rand -hex 16
SALT=TROQUE-ESTE-SALT

# Senha de acesso aos relatórios (/admin/...). Gere um com: openssl rand -hex 8
ADMIN_TOKEN=TROQUE-ESTE-TOKEN
